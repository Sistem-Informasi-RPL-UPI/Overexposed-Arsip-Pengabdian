DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require, INTERNAL_KEY=ganti-dengan-string-acak"

INTERNAL_KEY=isi random string

# Jeda crawling, nilainya ikut keputusan jeda (1,5 atau 3 detik)
DELAY_CATEGORY=3
DELAY_DOSEN_MIN=2.5
DELAY_DOSEN_MAX=5

# Port tempat FastAPI berjalan (opsional)
PORT=8000
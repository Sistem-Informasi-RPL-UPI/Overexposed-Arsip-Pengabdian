# Salin menjadi .env lalu isi. Jangan commit .env.

# URL pooled Neon (nama host berakhiran -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require

# String acak panjang, nilainya sama dengan INTERNAL_KEY di Next.js.
INTERNAL_KEY=ganti-dengan-string-acak

# Jeda antar tab SINTA (detik, PRD 5.3) dan jeda acak antar dosen.
DELAY_CATEGORY=1.5
DELAY_DOSEN_MIN=2.5
DELAY_DOSEN_MAX=5

# IN_PROGRESS yang lebih tua dari ini (menit) ditandai FAILED saat layanan menyala.
SISA_IN_PROGRESS_MENIT=10

# Port FastAPI. Di Render diisi otomatis.
PORT=8000

# Opsional, hanya untuk tes integrasi (crawler/tests). Sebaiknya database terpisah.
# CRAWLER_TEST_DATABASE_URL=

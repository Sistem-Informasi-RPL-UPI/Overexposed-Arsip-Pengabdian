DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

INTERNAL_KEY="ganti-dengan-string-acak"

# Jalankan layanan Python dari crawler/app dengan ..\.venv\Scripts\python.exe -m uvicorn main:app --port 8000.
CRAWLER_URL=http://127.0.0.1:8000

# SSO SACIBIRU
SSO_URL="https://sso.example.ac.id"
SSO_CLIENT_ID="modul-anda"
SSO_CLIENT_SECRET=""
SSO_REDIRECT_URI="http://localhost:3000/auth/callback"
SSO_POST_LOGOUT_URI="http://localhost:3000/"

# Rahasia sesi lokal (wajib minimal 32 karakter acak, misal: openssl rand -base64 32)
SESSION_SECRET=""
